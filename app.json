{
  "expo": {
    "name": "LikhaLocal",
    "slug": "LikhaLocal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/likhalocal-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5",
        "foregroundImage": "./assets/likhalocal-logo.png"
      },
      "package": "com.mary2026.LikhaLocal"
    },
    "web": {
      "favicon": "./assets/likhalocal-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F5",
          "image": "./assets/likhalocal-logo.png",
          "imageWidth": 200,
          "android": {
            "backgroundColor": "#FAF9F5",
            "image": "./assets/likhalocal-logo.png",
            "imageWidth": 200
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2db22d42-f539-40e5-95aa-83623293c5bb"
      }
    }
  }
}